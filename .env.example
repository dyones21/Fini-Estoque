# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPER_ADMIN_EMAILS: Lista de e-mails de super administradores separados por vírgula.
SUPER_ADMIN_EMAILS="seu_email_admin@exemplo.com"

# Supabase / PostgreSQL Database Connection (Configurado no Backend via Drizzle)
# Option 1: Connection string (Transaction Pooler ou Direct)
DATABASE_URL="postgresql://postgres.seu_projeto:sua_senha_aqui@aws-0-regiao.pooler.supabase.com:5432/postgres"

# Option 2: Discrete parameters
SQL_HOST="aws-0-regiao.pooler.supabase.com"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres.seu_projeto"
SQL_PASSWORD="sua_senha_aqui"
SQL_SSL="true"

# Firebase Client Configuration (Frontend - Vite)
# Obtido no console do Firebase (Configurações do Projeto > Seus aplicativos > SDK setup and configuration)
VITE_FIREBASE_API_KEY="AIzaSy_sua_api_key_aqui"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto-firebase.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-firebase"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto-firebase.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Firebase Admin SDK Configuration (Backend - Express)
# Opcional se rodando no Google Cloud com ADC, ou configure a chave de conta de serviço:
FIREBASE_PROJECT_ID="seu-projeto-firebase"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto-firebase.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
