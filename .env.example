# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPER_ADMIN_EMAILS: Lista de e-mails de super administradores separados por vírgula.
# Apenas e-mails contidos nesta lista recebem o cargo super_admin no login/sincronização.
SUPER_ADMIN_EMAILS="seu_email_admin@exemplo.com"

# Supabase / PostgreSQL Database Connection (Configurado no Backend via Drizzle)
# Option 1: Connection string (Transaction Pooler ou Direct)
DATABASE_URL="postgresql://postgres.seu_projeto:sua_senha_aqui@aws-0-regiao.pooler.supabase.com:5432/postgres"

# Option 2: Discrete parameters
SQL_HOST="aws-0-regiao.pooler.supabase.com"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="postgres.seu_projeto"
SQL_PASSWORD="sua_senha_aqui"
SQL_SSL="true"
