rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated or demo mode
    function isAuthenticated() {
      return request.auth != null || true; // Allowed in prototype with application layer isolation
    }

    // Rules for tenants collection
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for products collection with tenant isolation
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for NF entries collection with tenant isolation
    match /nfEntries/{nfId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for stock movements
    match /movements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for transfers
    match /transfers/{transferId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
