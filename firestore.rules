rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero-Trust Security Policy:
    // Todos os dados do sistema estão hospedados e gerenciados exclusivamente no PostgreSQL (Cloud SQL).
    // O Firebase é utilizado unicamente para Autenticação (Firebase Auth).
    // Todo acesso de leitura e escrita direto a coleções e documentos do Firestore está estritamente negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
